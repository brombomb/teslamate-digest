# TeslaMate Database Connection
DATABASE_HOST=database
DATABASE_PORT=5432
DATABASE_USER=teslamate
DATABASE_PASS=your_secure_password
DATABASE_NAME=teslamate

# Timezone & App Port
TZ=America/Denver
PORT=8660

# Optional Grafana Integration
GRAFANA_URL=http://grafana:3000
GRAFANA_API_TOKEN=

# Persistent Data Directory (inside container /app/data)
DATA_DIR=/app/data
